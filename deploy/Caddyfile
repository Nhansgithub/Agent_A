# Caddy reverse proxy + automatic TLS (AD-21, PRD §15.4).
#
# Caddy terminates HTTPS on :443 and proxies ONLY the public webhook path to the app. The app's
# /admin/* endpoints are deliberately NOT proxied — they are reached over localhost by the cron
# reconciler (AD-22), never from the internet.
#
# The domain must already resolve to this Droplet when Caddy starts: Let's Encrypt proves ownership
# over HTTP-01, and repeated failures for a wrong name are rate-limited.
#
# This uses the apex `poetroastery.com`, which already has an A record on the Droplet. Note that it
# claims the whole domain: everything except /webhooks/* and /health answers 404, so if the apex is
# ever wanted for a real site, move this to a subdomain (e.g. `agent.poetroastery.com`) and add the
# matching A record.

poetroastery.com {
	encode gzip

	# Only the webhook endpoint is public. Everything else (docs, admin) is not exposed.
	handle /webhooks/* {
		reverse_proxy 127.0.0.1:8000
	}

	# A public health check for uptime monitoring is fine; it reveals nothing.
	handle /health {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "Not found" 404
	}

	# Access logs go to stderr, which systemd captures into the journal (`journalctl -u caddy`).
	# Deliberately NOT a file: the packaged unit runs Caddy as the `caddy` user under
	# `ProtectSystem=full`, and writing to /var/log/caddy failed with EACCES even with the directory
	# chowned — and on a 25 GB disk an unrotated access log is its own hazard. journald already
	# rotates and size-caps for us (AD-21).
	log {
		output stderr
	}
}

# Agent B's internal Knowledge Base — the Quartz static site (S-B5). A SUBDOMAIN, so it never collides
# with the apex webhook vhost above. Add an A record for `agent.poetroastery.com` → this Droplet (B-4);
# Caddy then gets its own Let's Encrypt cert for the name automatically.
#
# Read-only and UNAUTHENTICATED by the owner's call (D-45): it serves pre-built static files only, with
# no proxy to the app and no admin surface — nothing here can mutate state. The site is built OFF-box
# (deploy/build_site.sh) and its output dir (AgentBConfig.publish.output_dir, default data/site) is
# rsynced/mounted to the path below. `file_server` with `try_files` gives Quartz's clean URLs.
agent.poetroastery.com {
	encode gzip
	root * /opt/agent/data/site
	try_files {path} {path}/ {path}.html
	file_server

	log {
		output stderr
	}
}
