# ---------------------------------------------------------------------------------------------
# Secrets — AD-4: credentials are supplied by environment reference and NEVER written into the
# config registry or the source tree. Copy to .env (which is gitignored) and fill in.
#
# ⚠️  THIS IS A TEMPLATE AND IS TRACKED BY GIT. Put REAL secrets only in `.env`, never here.
#
# Each `env:PREFIX` reference in config/registry.yaml expands to three variables:
#   <PREFIX>_BASE_URL, <PREFIX>_EMAIL, <PREFIX>_API_TOKEN
#
# PRODUCTION NOTE (AD-20): every tenant's Atlassian token lives in this one file, so its blast
# radius is *every* tenant. Production must scope and rotate per-tenant credentials. The demo keeps
# the single .env per the PRD's signed-off stance.
# ---------------------------------------------------------------------------------------------

# --- Atlassian: tenant `project_alpha` --------------------------------------------------------
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
ALPHA_JIRA_BASE_URL=https://your-site.atlassian.net
ALPHA_JIRA_EMAIL=service-account@example.com
ALPHA_JIRA_API_TOKEN=

ALPHA_CONF_BASE_URL=https://your-site.atlassian.net
ALPHA_CONF_EMAIL=service-account@example.com
ALPHA_CONF_API_TOKEN=

# --- Webhook authentication (AD-8, PRD §15.4) --------------------------------------------------
# A shared secret sent by the Jira/Confluence webhook configuration and checked on every request
# BEFORE any processing. The public endpoint triggers real Atlassian writes, so this is a security
# Must, not a nice-to-have. Generate with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=

# --- Admin endpoint (AD-22) --------------------------------------------------------------------
# Authenticates the localhost reconcile/liveness endpoint the cron sweep calls.
ADMIN_API_TOKEN=

# --- Anthropic Claude API (AD-6) ---------------------------------------------------------------
# All six role-agents run on this key. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- LangSmith (AD-20, NFR-01) -----------------------------------------------------------------
# Set system.observability.langsmith_enabled: true in the registry to activate tracing.
LANGSMITH_API_KEY=

# --- Off-box state backup (AD-23) --------------------------------------------------------------
# litestream streams the SQLite WAL to DigitalOcean Spaces. Run state is authoritative ONLY on the
# Droplet disk, so losing it mid-run risks double-create / re-publish on webhook redelivery.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
